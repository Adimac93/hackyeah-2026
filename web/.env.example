# Copy to web/.env.local. Each key is explained in the root .env.example.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server-only: team invite emails
SUPABASE_SECRET_KEY=
# optional: `just migrate` / `just seed` read it from here too
SUPABASE_DB_URL=

# Security assistant models (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
OPENAI_API_KEY=
OPENAI_MODELS=
LLM_COMPATIBLE_NAME=
LLM_COMPATIBLE_BASE_URL=
LLM_COMPATIBLE_API_KEY=
LLM_COMPATIBLE_MODELS=

# The AI Control Layer gateway, e.g. http://localhost:8080
GATEWAY_URL=
# Server-only: Bearer key of the gateway principal chat runs as; it must have
# delegates_users, since each prompt names its user in X-On-Behalf-Of. Chat through
# the gateway is offered only when this and GATEWAY_URL are set. Seed: console-chat-dev-key.
GATEWAY_API_KEY=
GATEWAY_MODELS=
# Server-only: Bearer key of a gateway principal with role security_admin. Streams and
# decides agent access requests. Policy edits, /policy, /metrics and /admin/risk use
# the signed-in user's Supabase session instead.
GATEWAY_ADMIN_KEY=

# Demo: one-click "Log in as admin" on /login so judges needn't create accounts.
# Off unless DEMO_ADMIN_LOGIN=true. Server-only — the password never reaches the browser.
# The account must exist in Supabase Auth and be an admin on the security team.
DEMO_ADMIN_LOGIN=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
