# Copy to web/.env.local. Each key is explained in the root .env.example.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server-only: team invite emails
SUPABASE_SECRET_KEY=
# optional: `just migrate` / `just seed` read it from here too
SUPABASE_DB_URL=

# Security assistant models (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
OPENAI_API_KEY=
OPENAI_MODELS=
LLM_COMPATIBLE_NAME=
LLM_COMPATIBLE_BASE_URL=
LLM_COMPATIBLE_API_KEY=
LLM_COMPATIBLE_MODELS=

# The AI Control Layer gateway, e.g. http://localhost:8080
GATEWAY_URL=
GATEWAY_MODELS=
# Server-only: Bearer key of a gateway principal with role security_admin. Lets admins
# import a control catalog (TOML) on the Controls page via POST /admin/policy.
GATEWAY_ADMIN_KEY=
