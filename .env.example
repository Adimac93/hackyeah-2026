# Copy to .env and fill in. Never commit .env.
# Add every new secret here with an empty value so the team knows it exists.

# --- Supabase (project ref: wkxhfzjknxdyfwhnwogn) ---
# Pooled Postgres connection used by the gateway via sqlx.
# Dashboard -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=

# Data API, used by the admin dashboard.
SUPABASE_URL=https://wkxhfzjknxdyfwhnwogn.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never ships to a browser bundle.
SUPABASE_SECRET_KEY=

# --- Gateway ---
PORT=8080
POLICY_PATH=policy/control-catalog.toml

# Where model traffic is forwarded. Ollama speaks the OpenAI API on /v1.
UPSTREAM_URL=http://localhost:11434
