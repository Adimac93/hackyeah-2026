# Copy to .env and fill in. Never commit .env.
# Add every new secret here with an empty value so the team knows it exists.

# Supabase (web/) — Project Settings → API. Put these in web/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string, only needed for `just seed`
SUPABASE_DB_URL=

# Security assistant models (web/, server-only — put in web/.env.local, never NEXT_PUBLIC_).
# Each provider appears in the chat's model picker only when its key is set; the offline demo model is always there.
ANTHROPIC_API_KEY=
# optional, comma-separated; default: claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5
ANTHROPIC_MODELS=
OPENAI_API_KEY=
# optional, comma-separated; default: gpt-5,gpt-5-mini
OPENAI_MODELS=
# Any OpenAI-compatible API (Groq, OpenRouter, Mistral, Ollama…). Listed only when BASE_URL and MODELS are set.
LLM_COMPATIBLE_NAME=
LLM_COMPATIBLE_BASE_URL=
LLM_COMPATIBLE_API_KEY=
LLM_COMPATIBLE_MODELS=
