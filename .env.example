# Copy to .env and fill in. Never commit .env.
# Add every new secret here with an empty value so the team knows it exists.
#
# Two apps, two files: the gateway reads .env at the repo root, the web app
# reads web/.env.local. Keys are listed here once so nobody has to guess which
# side wants what.

# ============================ gateway (root .env) ============================

# --- Supabase (project ref: wkxhfzjknxdyfwhnwogn) ---
# Pooled Postgres connection used by the gateway via sqlx. Use the SESSION
# pooler: the direct host is IPv6-only, and transaction mode breaks sqlx's
# prepared statements.
DATABASE_URL=

# Data API, if the gateway ever reads through it rather than over Postgres.
SUPABASE_URL=https://wkxhfzjknxdyfwhnwogn.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never ships to a browser bundle.
SUPABASE_SECRET_KEY=

# --- Gateway ---
# dev | prod. prod switches logging to JSON for Cloud Logging and stops
# allowing every browser origin by default.
ENVIRONMENT=dev

# Cloud Run injects PORT; this is only the local default.
PORT=8080

# Comma-separated origins allowed to call the gateway from a browser, or `*`
# for any. Left unset in prod, no cross-origin caller is permitted.
#
# CORS restricts browsers only. Gateway integration endpoints always require
# `Authorization: Bearer <per-principal API key>`; the database stores only
# each key's SHA-256 digest in `principals.api_key_hash`.
CORS_ORIGINS=*
POLICY_PATH=policy/control-catalog.toml

# Where model traffic is forwarded. `mock` (the default) answers with a canned
# echo so dev needs no model; prod refuses it. Ollama speaks the OpenAI API on
# /v1, e.g. http://localhost:11434 or the Ollama Cloud Run GPU service.
UPSTREAM_URL=mock

# --- Semantic tier ---
# The judge. `mock` (the default) scores from each control's `mock_keywords`;
# prod refuses it. With a real but unreachable Ollama, semantic controls fail
# closed (fail_mode in the catalog), so suspicious traffic is refused rather
# than waved through.
OLLAMA_URL=mock
SEMANTIC_MODEL=llama3.1:8b

# --- Reporting ---
# Trailing window for `just report`.
REPORT_WINDOW_HOURS=24

# ========================== web app (web/.env.local) =========================

# Supabase (web/) — Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (Project Settings → API keys → Secret). Used to send team invite emails.
# Never NEXT_PUBLIC_, never in the browser.
SUPABASE_SECRET_KEY=
# Postgres connection string for `just migrate` / `just seed` (here or in web/.env.local)
SUPABASE_DB_URL=

# Security assistant models (server-only — never NEXT_PUBLIC_).
# Each provider appears in the chat's model picker only when its key is set;
# the offline demo model is always there.
ANTHROPIC_API_KEY=
# optional, comma-separated; default: claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5
ANTHROPIC_MODELS=
OPENAI_API_KEY=
# optional, comma-separated; default: gpt-5,gpt-5-mini
OPENAI_MODELS=
# Any OpenAI-compatible API (Groq, OpenRouter, Mistral, Ollama…). Listed only
# when BASE_URL and MODELS are set.
LLM_COMPATIBLE_NAME=
LLM_COMPATIBLE_BASE_URL=
LLM_COMPATIBLE_API_KEY=
LLM_COMPATIBLE_MODELS=

# The AI Control Layer gateway (`just dev`, default http://localhost:8080). When
# set, chat offers "Gateway <model> (protected)" first: every prompt and answer
# is policed and audited per user.
GATEWAY_URL=
# optional, comma-separated; must be in the gateway's [models] allowed list.
# default: llama3.1:8b
GATEWAY_MODELS=

# `just seed` creates local demo principals. These are intentionally public
# demo fixtures; generate a distinct random key for each real caller.
# demo-agent: demo-agent-dev-key (security admin)
# red-team: red-team-dev-key
