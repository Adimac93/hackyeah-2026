# Copy to .env and fill in. Never commit .env.
# Add every new secret here with an empty value so the team knows it exists.

# --- Supabase (project ref: wkxhfzjknxdyfwhnwogn) ---
# Pooled Postgres connection used by the gateway via sqlx.
# Dashboard -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=

# Data API, used by the admin dashboard.
SUPABASE_URL=https://wkxhfzjknxdyfwhnwogn.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never ships to a browser bundle.
SUPABASE_SECRET_KEY=

# --- Gateway ---
PORT=8080
POLICY_PATH=policy/control-catalog.toml

# Where model traffic is forwarded. Ollama speaks the OpenAI API on /v1.
UPSTREAM_URL=http://localhost:11434

# --- Semantic tier ---
# The local judge. Without a reachable Ollama, semantic controls fail closed
# (fail_mode in the catalog), so suspicious traffic is refused rather than
# waved through. Install Ollama and pull the model before the demo.
OLLAMA_URL=http://localhost:11434
SEMANTIC_MODEL=llama3.1:8b
# Production only: the judge on a VPC-internal Vertex AI endpoint instead of
# OLLAMA_URL. Values come from `terraform -chdir=infra output`; the CA is the
# PEM in Secret Manager `vertex-judge-ca`. See infra/README.md.
SEMANTIC_BACKEND=
VERTEX_JUDGE_URL=
VERTEX_JUDGE_IP=
VERTEX_JUDGE_CA=

# --- Reporting ---
# Trailing window for `just report`.
REPORT_WINDOW_HOURS=24
